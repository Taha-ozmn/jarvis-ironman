# Cursor API key — https://cursor.com/dashboard/integrations
# Used when jarvis.llm_provider is "cursor".
CURSOR_API_KEY=cursor_your_key_here

# NVIDIA API key — https://build.nvidia.com /
# Used when jarvis.llm_provider is "nvidia" (preferred if set).
# NVIDIA_API_KEY=nvapi-your_key_here

# Jarvis voice — British English replies; Turkish speech understanding
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_USER_NAME=sir
JARVIS_LANGUAGE=en-GB
JARVIS_LISTEN_LANGUAGE=tr-TR
